DB_HOST=postgres
DB_PORT=5432
DB_NAME=clipforge
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=databaseurl
GEMINI_API_KEY=geminiapikey
YOUTUBE_API_KEY=youtubeapikey
RABBITMQ_HOST=rabbitmq

# "local" or "hosted" — switch which RabbitMQ URL the worker connects to
RABBITMQ_ENV=local
RABBITMQ_LOCAL_URL=amqp://guest:guest@rabbitmq:5672/%2F
RABBITMQ_HOSTED_URL=

# Queue the worker consumes from (must match the existing jobs.created queue
# declared by outbox-worker — do not point this at a new queue)
QUEUE_NAME=jobs.created
PREFETCH_COUNT=4
